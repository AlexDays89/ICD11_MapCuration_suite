# Copiar a `.env` (mismo directorio) y completar con las credenciales de
# https://icd.who.int/icdapi (sección "View API access key(s)").
# `.env` está en .gitignore: nunca versionar las credenciales reales.

# --- Solo servidor (sin prefijo VITE_: nunca llegan al navegador) ---------
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
ICD_TOKEN_ENDPOINT=https://icdaccessmanagement.who.int/connect/token
ICD_SCOPE=icdapi_access

# --- Expuestas al cliente (no son secretas) -------------------------------
# API de producción de la OMS (requiere el token OAuth2).
VITE_ICD_API_SERVER_URL=https://id.who.int
# Release de la CIE-11 MMS que usan el widget y las consultas de detalle.
VITE_ICD11_RELEASE=2026-01
